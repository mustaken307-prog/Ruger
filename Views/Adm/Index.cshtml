@model IEnumerable<RC.Models.AppUser>
@{
    ViewData["Title"] = "لوحة الأدمن";
}

<div class="max-w-7xl mx-auto px-6 py-12">
    <div class="flex items-center gap-4 mb-8">
        <div class="bg-purple-900/50 p-4 rounded-xl border border-purple-500/30">
            <i data-lucide="shield-check" class="w-8 h-8 text-purple-400"></i>
        </div>
        <div>
            <h1 class="text-3xl font-bold text-white">لوحة التحكم (الأدمن)</h1>
            <p class="text-slate-400">إدارة المشتركين ومساحاتهم</p>
        </div>
    </div>

    <div class="glass rounded-2xl overflow-hidden border border-slate-700">
        <div class="overflow-x-auto">
            <table class="w-full text-right">
                <thead class="bg-slate-900/80 border-b border-slate-700 text-slate-300">
                    <tr>
                        <th class="p-4 font-semibold">الاسم</th>
                        <th class="p-4 font-semibold">البريد الإلكتروني</th>
                        <th class="p-4 font-semibold">رقم الهاتف</th>
                        <th class="p-4 font-semibold">الحد الأقصى للسيارات</th>
                        <th class="p-4 font-semibold">إجراءات</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-800">
                    @foreach (var user in Model)
                    {
                        <tr class="hover:bg-slate-800/50 transition-colors">
                            <td class="p-4 text-white">@user.FullName</td>
                            <td class="p-4 text-slate-400">@user.Email</td>
                            <td class="p-4 text-slate-400">@user.PhoneNumber</td>
                            <td class="p-4">
                                <!-- نموذج تعديل الحصة -->
                                <form asp-action="UpdateQuota" method="post" class="flex items-center gap-2">
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <input type="number" name="quota" value="@user.CarQuota" min="0" max="10"
                                           class="w-16 bg-slate-900 border border-slate-600 text-white rounded px-2 py-1 text-center" />
                                    <button type="submit" class="text-blue-400 hover:text-blue-300" title="تحديث">
                                        <i data-lucide="save" class="w-5 h-5"></i>
                                    </button>
                                </form>
                            </td>
                            <td class="p-4">
                                <!-- نموذج الحذف -->
                                <form asp-action="DeleteUser" method="post" onsubmit="return confirm('هل أنت متأكد من حذف هذا المشترك وكل سياراته؟');">
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <button type="submit" class="text-red-400 hover:text-red-300 flex items-center gap-1">
                                        <i data-lucide="trash-2" class="w-5 h-5"></i> حذف
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (!Model.Any())
        {
            <div class="p-10 text-center text-slate-400">
                لا يوجد مشتركين حالياً.
            </div>
        }
    </div>
</div>