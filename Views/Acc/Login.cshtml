@model RC.ViewModels.LogVM
@{
    ViewData["Title"] = "تسجيل الدخول";
}

<div class="flex items-center justify-center min-h-[80vh] px-4">
    <div class="glass p-8 rounded-2xl w-full max-w-md border border-slate-700 relative overflow-hidden group">
        <!-- تأثيرات خلفية -->
        <div class="absolute -top-10 -right-10 w-32 h-32 bg-purple-600 rounded-full blur-[80px] opacity-30 group-hover:opacity-50 transition-opacity"></div>

        <div class="text-center mb-8 relative z-10">
            <h2 class="text-3xl font-tech font-bold text-white mb-2">مرحباً بعودتك</h2>
            <p class="text-slate-400">سجل دخولك للوصول إلى لوحة التحكم</p>
        </div>

        <form asp-action="Login" method="post" class="relative z-10">
            <div asp-validation-summary="ModelOnly" class="text-red-400 text-sm mb-4 bg-red-400/10 p-3 rounded-lg border border-red-400/20"></div>

            <div class="mb-4">
                <label asp-for="Email" class="block text-sm text-slate-300 mb-2"></label>
                <div class="relative">
                    <i data-lucide="mail" class="absolute right-3 top-3.5 w-5 h-5 text-slate-500"></i>
                    <input asp-for="Email" class="w-full bg-slate-900 border border-slate-700 text-white rounded-lg py-3 pr-10 pl-4 focus:outline-none focus:border-purple-500 transition-colors" placeholder="example@mail.com" />
                </div>
                <span asp-validation-for="Email" class="text-red-400 text-xs mt-1 block"></span>
            </div>

            <div class="mb-6">
                <label asp-for="Password" class="block text-sm text-slate-300 mb-2"></label>
                <div class="relative">
                    <i data-lucide="lock" class="absolute right-3 top-3.5 w-5 h-5 text-slate-500"></i>
                    <input asp-for="Password" class="w-full bg-slate-900 border border-slate-700 text-white rounded-lg py-3 pr-10 pl-4 focus:outline-none focus:border-purple-500 transition-colors" placeholder="••••••••" />
                </div>
                <span asp-validation-for="Password" class="text-red-400 text-xs mt-1 block"></span>
            </div>

            <div class="flex items-center justify-between mb-6">
                <label class="flex items-center gap-2 text-sm text-slate-400 cursor-pointer">
                    <input asp-for="RememberMe" class="rounded bg-slate-900 border-slate-700 text-purple-500 focus:ring-purple-500">
                    تذكرني
                </label>
                <a asp-action="Register" class="text-sm text-purple-400 hover:text-purple-300">ليس لديك حساب؟</a>
            </div>

            <button type="submit" class="w-full bg-gradient-to-r from-blue-700 to-purple-700 hover:from-blue-600 hover:to-purple-600 text-white font-bold py-3 rounded-lg transition-all hover:shadow-[0_0_15px_rgba(139,92,246,0.4)]">
                تسجيل الدخول
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}