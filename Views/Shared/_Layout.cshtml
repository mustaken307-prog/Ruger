<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>RUGER | @ViewData["Title"]</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- أيقونات Lucide -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <!-- خطوط جوجل الفخمة -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;800&family=Orbitron:wght@500;700&display=swap" rel="stylesheet">

    <style>
            body { font-family: 'Cairo', sans-serif; background-color: #0a0a0a; color: #cbd5e1; }
            .font-tech { font-family: 'Orbitron', sans-serif; }

            /* تأثير الزجاج الفخم */
            .glass { background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(12px); border: 1px solid rgba(203, 213, 225, 0.1); }

            /* تأثير التوهج الفضي والبنفسجي */
            .glow-silver:hover { box-shadow: 0 0 15px rgba(203, 213, 225, 0.3); border-color: rgba(203, 213, 225, 0.5); }
            .glow-purple:hover { box-shadow: 0 0 20px rgba(76, 29, 149, 0.6); border-color: rgba(139, 92, 246, 0.5); }

            /* تدرج الألوان للشعار */
            .text-gradient {
                background: linear-gradient(to right, #cbd5e1, #a855f7, #3b82f6);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
            }
    </style>
</head>
<body class="min-h-screen flex flex-col">

    <!-- شريط التنقل -->
    <nav class="glass sticky top-0 z-50 px-6 py-4">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <!-- الشعار -->
            <a asp-controller="Hom" asp-action="Index" class="flex items-center gap-3 group">
                <!-- مكان شعار ترافالجا لو -->
                <div class="w-12 h-12 rounded-full border-2 border-slate-500 group-hover:border-purple-500 transition-all flex items-center justify-center p-1 glow-purple">
                    <!-- استبدل الرابط أدناه برابط صورة شعار ترافالجا لو -->
                    <img src="~/images/law.jpg" alt="Law Logo" class="w-full h-full object-cover rounded-full">
                </div>
                <span class="text-3xl font-tech font-bold text-gradient tracking-widest">RUGER</span>
            </a>

            <!-- القائمة -->
            <div class="flex items-center gap-6">
                @if (User.Identity!.IsAuthenticated)
                {
                    <span class="text-sm font-semibold text-slate-300">مرحباً، @User.Identity.Name</span>
                    <form asp-controller="Acc" asp-action="Logout" method="post">
                        <button type="submit" class="flex items-center gap-2 text-red-400 hover:text-red-300 transition-colors">
                            <i data-lucide="log-out" class="w-5 h-5"></i> خروج
                        </button>
                    </form>
                }
                else
                {
                    <a asp-controller="Acc" asp-action="Login" class="flex items-center gap-2 text-slate-300 hover:text-white transition-all hover:scale-105">
                        <i data-lucide="user" class="w-5 h-5"></i> تسجيل الدخول
                    </a>
                    <a asp-controller="Acc" asp-action="Register" class="bg-gradient-to-r from-blue-700 to-purple-700 hover:from-blue-600 hover:to-purple-600 text-white px-5 py-2 rounded-lg font-bold transition-all hover:shadow-[0_0_15px_rgba(139,92,246,0.5)]">
                        إنشاء حساب
                    </a>
                }
            </div>
        </div>
    </nav>

    <!-- محتوى الصفحات -->
    <main class="flex-grow">
        @RenderBody()
    </main>

    <!-- تذييل الصفحة -->
    <footer class="glass mt-auto py-6 text-center text-sm text-slate-500 border-t border-slate-800">
        <p>© 2024 RUGER Cars. All rights reserved. Designed for the New Era.</p>
    </footer>

    <script>
            // تفعيل الأيقونات
            lucide.createIcons();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>